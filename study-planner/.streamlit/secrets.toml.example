# Copy this file to .streamlit/secrets.toml for local runs, and paste the same
# content into Streamlit Community Cloud > App settings > Secrets when deployed.
# NEVER commit the real secrets.toml (it is in .gitignore).

# Postgres connection string (Supabase, Neon, ...). Leave this line out to use a local SQLite file.
database_url = "postgresql://USER:PASSWORD@HOST:5432/postgres"

# Your timezone, so "today" and the week strip are correct in the evening.
timezone = "America/Vancouver"

# One line per person: name = "password". Pick your own names and passwords.
[users]
Abbie = "change-me-1"
Buddy = "change-me-2"
